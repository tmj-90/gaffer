{
  "name": "gaffer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Gaffer \u2014 a local-first autonomous software factory: a control plane, runtime, durable memory, and orchestrator that plans, builds, tests, and reviews software from tickets, on your own machine.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "agentic-ai",
    "autonomous-agents",
    "llm",
    "claude",
    "anthropic",
    "developer-tools",
    "local-first",
    "self-hosted",
    "human-in-the-loop",
    "code-review",
    "automation",
    "typescript",
    "cli"
  ],
  "homepage": "https://github.com/tmj-90/gaffer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tmj-90/gaffer"
  },
  "bugs": {
    "url": "https://github.com/tmj-90/gaffer/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "typecheck:test": "pnpm -r typecheck:test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm -r build && pnpm -r typecheck && pnpm -r typecheck:test && pnpm -r test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.5",
      "postcss": "^8.5.18",
      "nanoid": "^3.3.17",
      "undici": "^7.29.0",
      "ip-address": "^10.3.1"
    }
  },
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
