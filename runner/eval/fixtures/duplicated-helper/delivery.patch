diff --git a/src/tasks.js b/src/tasks.js
index 46499a5..74d00a9 100644
--- a/src/tasks.js
+++ b/src/tasks.js
@@ -5,3 +5,11 @@ export function addTask(list, title) {
 export function completeTask(list, title) {
   return list.map((t) => (t.title === title ? { ...t, done: true } : t));
 }
+
+function appendTask(list, title) {
+  return [...list, { title, done: false }];
+}
+
+export function addTasks(list, titles) {
+  return titles.reduce((acc, title) => appendTask(acc, title), list);
+}
