diff --git a/src/tasks.js b/src/tasks.js
index 46499a5..f5def2c 100644
--- a/src/tasks.js
+++ b/src/tasks.js
@@ -5,3 +5,7 @@ export function addTask(list, title) {
 export function completeTask(list, title) {
   return list.map((t) => (t.title === title ? { ...t, done: true } : t));
 }
+
+export function removeTask(list, title) {
+  return list.filter((t) => t.title !== title);
+}
