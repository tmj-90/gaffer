#!/usr/bin/env bash
# gaffer — friendly front door to the factory.
#
#   gaffer setup                      nothing → running: build + init + open the UI
#   gaffer onboard <path> [--standalone] [--name <alias>]   scan + register a repo (standalone scope — the default; map to a
#                                     wider scope in the Factory Map UI)
#   gaffer dashboard [--restart|--stop|--lan|--foreground]
#                                     start the web dashboard (--restart = stop it, rotate the login
#                                     token, start fresh; --stop = stop it; --lan = token-protected,
#                                     on your LAN; --foreground = run in THIS process for supervisors)
#   gaffer status                     what's registered + what's running
#   gaffer demo                       one dry tick over a showcase repo (a fresh temp dir; DRY_RUN)
#   gaffer skills [install]           list the skill library / install it into your Claude Code
#   gaffer eval [--json]              delivery-quality metrics (pass rate · memory score gap · cost/pass)
#   gaffer run [--dry-run] [--daemon] [--interval N]
#                                     go live: one supervisor pass (drains the ready queue), or
#                                     --daemon = re-run it every N seconds until SIGINT/SIGTERM;
#                                     --dry-run (-n) = preview only, nothing spent
#   gaffer wg <dispatch args…>        the dispatch CLI against THIS factory's database
#                                     (e.g. gaffer wg ticket create -t "…" -d "…"; gaffer wg ticket show 1)
#   gaffer approve <ticket> [--reviewer <you>] [--commit <repo>=<sha>]…   the human review gate:
#                                     approve a ticket in Review — the commits you reviewed
#                                     (shown and confirmed when --commit is omitted)
#   gaffer merge <ticket>             land an APPROVED (ready_for_merge) ticket — what the dashboard's
#                                     Merge button runs; refuses (exit 4) a ticket not yet approved
#                                     or unknown; a done ticket is "already merged" (exit 0)
#   gaffer eval replay [--out <dir>]  replay the golden gate fixtures through the real gate pipeline
#   gaffer help | --version
#
#   Every command takes -h/--help; an unknown command or option exits 2 and does nothing.
#
# Everything uses the factory's own config/state under $GAFFER_DATA — no flags to remember.
set -uo pipefail
# The real runner/ dir, even when this file is reached through a symlink on PATH
# (`ln -s …/runner/gaffer ~/bin/gaffer`): follow each link (relative targets resolve
# against the link's own dir), then take the physical dir. Portable to macOS bash 3.2,
# which has no `readlink -f`. Without it, a symlinked gaffer looked for
# factory.config.sh next to the link and died with "RUNNER_DIR: unbound variable".
_gaffer_self="${BASH_SOURCE[0]}"
while [ -L "$_gaffer_self" ]; do
  _gaffer_link_dir="$(cd -P "$(dirname "$_gaffer_self")" && pwd)"
  _gaffer_self="$(readlink "$_gaffer_self")"
  case "$_gaffer_self" in /*) ;; *) _gaffer_self="$_gaffer_link_dir/$_gaffer_self" ;; esac
done
HERE="$(cd -P "$(dirname "$_gaffer_self")" && pwd)"
unset _gaffer_self _gaffer_link_dir
# The operator's OWN DRY_RUN, captured BEFORE factory.config.sh fills in its default
# (DRY_RUN=1). `gaffer run` is the go-live command: it must default to a LIVE pass, and
# only an explicit DRY_RUN=1 in the caller's environment keeps it dry. Reading DRY_RUN
# after the source made every `gaffer run` a dry run while help, README and quickstart
# all called it "go live".
_GAFFER_OP_DRY_RUN="${DRY_RUN-}"
# An operator-set dashboard token (the server then uses it instead of the token file).
_GAFFER_OP_API_TOKEN="${DISPATCH_API_TOKEN:-}"
# shellcheck source=factory.config.sh
source "$HERE/factory.config.sh"

# Colour only for a person at a terminal: not in a pipe / file, not under NO_COLOR or
# TERM=dumb (lib/colour.sh). err() writes to stderr, so it asks about stderr.
# shellcheck source=lib/colour.sh
. "$HERE/lib/colour.sh"
gaffer_colours 1
_e_red=''; _e_off=''; gaffer_colour_on 2 && { _e_red='\033[1;31m'; _e_off='\033[0m'; }
say() { printf "${c_cya}gaffer${c_off} %s\n" "$*"; }
ok()  { printf "  ${c_grn}✓${c_off} %s\n" "$*"; }
warn(){ printf "  ${c_yel}!${c_off} %s\n" "$*"; }
err() { printf "  ${_e_red}✗${_e_off} %s\n" "$*" >&2; }

# One usage line per command — what `gaffer <cmd> --help` prints, and what a bad
# argument is pointed at. Kept next to the header block above, which is `gaffer help`.
usage() {
  case "$1" in
    onboard)   echo "usage: gaffer onboard <path> [--standalone] [--name <alias>]   (standalone scope is the default; map it to a wider scope in the Factory Map UI; --name registers it under an alias when another repository already has its directory name)" ;;
    dashboard) echo "usage: gaffer dashboard [--restart] [--stop] [--lan] [--foreground]   (--restart rotates the login token)" ;;
    status)    echo "usage: gaffer status   (doctors + work counts + what needs a human)" ;;
    setup)     echo "usage: gaffer setup   (install + build + init state + open the dashboard)" ;;
    demo)      echo "usage: gaffer demo   (one dry tick over a showcase repo in a fresh temp dir, or DEMO_DIR; always DRY_RUN, nothing spent)" ;;
    eval)      echo "usage: gaffer eval [--json] | gaffer eval replay [--out <dir>]" ;;
    approve)   echo "usage: gaffer approve <ticket> [--reviewer <you>] [--commit <repo>=<sha>]…" ;;
    merge)     echo "usage: gaffer merge <ticket>   (the ticket must be approved: gaffer approve <ticket>)" ;;
    run)       echo "usage: gaffer run [--dry-run|-n] [--daemon] [--interval <seconds>]   (LIVE by default: claims ready tickets and spends model budget)" ;;
    skills)    echo "usage: gaffer skills [list | install [--user|--project] [--force] | add <path|git-url> [--force]]" ;;
  esac
}
# wants_help "$@" — true when any argument asks for help. Checked before a command
# does anything, wherever the flag sits, so `gaffer run --daemon --help` never runs.
wants_help() { local a; for a in "$@"; do case "$a" in -h|--help) return 0 ;; esac; done; return 1; }
# bad_arg <cmd> <message> — refuse a bad argument: message + usage on stderr, exit 2.
bad_arg() { err "$2"; usage "$1" >&2; exit 2; }

DASH_PORT="${DISPATCH_API_PORT:-8787}"
# JSON-encode one string for embedding in a JSON array literal (escape \ and ").
# Dispatch's parseCommand reads these defaults as a JSON string[] (verbatim argv),
# so a $RUNNER_DIR containing spaces stays a SINGLE argv element instead of being
# whitespace-split. No shell, no eval — pure string escaping of an operator value.
json_str() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }
# Build a ["bin","<runner>/bin/<script>"] JSON argv from RUNNER_DIR, space-safe.
dispatch_cmd() { printf '[%s,%s]' "$(json_str "$1")" "$(json_str "$RUNNER_DIR/bin/$2")"; }

# The dashboard's "Suggest work" button (POST /product-owner/runs) spawns this
# command, detached, with DISPATCH_PRODUCT_OWNER_REPO in its env naming the repo to
# suggest work for. It runs the product-owner skill headlessly and files draft
# tickets. JSON argv so the absolute path survives spaces in the checkout dir.
PRODUCT_OWNER_CMD="${DISPATCH_PRODUCT_OWNER_CMD:-$(dispatch_cmd node product-owner-run.mjs)}"
# Merge command the dashboard invokes when a ticket is APPROVED: attempts the
# conflict-safe merge; a conflict spawns the resolver agent + re-approval (never a
# force-merge). JSON argv so the absolute path survives spaces in the checkout dir.
MERGE_CMD="${DISPATCH_MERGE_CMD:-$(dispatch_cmd node merge-ticket.mjs)}"
# The dashboard's "Poll for work" button (POST /poll-work) spawns this: clears the
# skip files + runs a single live tick to deliver the next ready ticket on demand.
TICK_CMD="${DISPATCH_TICK_CMD:-$(dispatch_cmd bash poll-once.sh)}"
# The dashboard Memory view's "Onboard a repo" button (POST /repos/onboard) spawns
# this, detached, with DISPATCH_ONBOARD_REPO in its env naming the repo (name/id or
# path) to onboard. It runs crew's real `repo onboard` so the repo is scanned,
# registered, and its Memory digest + feature inventory land in the memory store
# the Memory views read. JSON argv so the absolute path survives spaces in the dir.
ONBOARD_CMD="${DISPATCH_ONBOARD_CMD:-$(dispatch_cmd node onboard-run.mjs)}"
# The BROWNFIELD epic → feature(`building`) hook: POST /epics spawns this, detached,
# when every ticket of the new epic targets ONE existing registered repo, so the
# memory feature ledger shows that feature as `building` (epic ref as provenance).
# Best-effort, no agent. JSON argv so the absolute path survives spaces in the dir.
EPIC_FEATURE_CMD="${DISPATCH_EPIC_FEATURE_CMD:-$(dispatch_cmd node epic-feature.mjs)}"

cmd="${1:-help}"; shift || true
case "$cmd" in
  onboard|dashboard|status|setup|demo|eval|approve|merge|run|skills)
    if wants_help "$@"; then usage "$cmd"; exit 0; fi ;;
esac
case "$cmd" in

onboard)
  # --standalone is the default scope (accepted, a no-op); --name <alias> registers the
  # repo under an alias (needed when a DIFFERENT repository already has its directory
  # name); any other option is refused.
  path=""; alias=""
  while [ "$#" -gt 0 ]; do
    a="$1"; shift
    case "$a" in
      --standalone) ;;
      --name) [ "$#" -gt 0 ] || bad_arg onboard "--name needs an alias"; alias="$1"; shift ;;
      --name=*) alias="${a#--name=}" ;;
      -*) bad_arg onboard "unknown option '$a'" ;;
      *) [ -z "$path" ] || bad_arg onboard "one path only (got '$path' and '$a')"; path="$a" ;;
    esac
  done
  # A missing or wrong path is a usage error: ✗ on stderr + the usage line, exit 2.
  [ -n "$path" ] || bad_arg onboard "onboard needs the path of a repository"
  abs="$(cd "$path" 2>/dev/null && pwd -P)" || bad_arg onboard "no such directory: $path"
  git -C "$abs" rev-parse --git-dir >/dev/null 2>&1 || warn "not a git repo (the factory branches per ticket — you'll want one)"
  # Route through onboard-run.mjs — the SAME path the dashboard's "Onboard a repo"
  # button uses: scan + register + the claude -p analysis (real digest + features +
  # cited lore drafts) into the memory store. Standalone single-repo scope by default;
  # map it to a wider scope from the Factory Map afterwards.
  say "onboarding $abs … (scan + register + claude -p analysis → memory)"
  GAFFER_DATA="$GAFFER_DATA" DISPATCH_DB="$DISPATCH_DB" CREW_DIR="$CREW_DIR" CREW_CONFIG="$CREW_CONFIG" \
    MEMORY_DB="$MEMORY_DB" MEMORY_CLI_BIN="$MEMORY_CLI_BIN" \
    GAFFER_PLAN_MODEL="${GAFFER_PLAN_MODEL:-}" GAFFER_TICK_TIMEOUT="${GAFFER_TICK_TIMEOUT:-}" GAFFER_MAX_TURNS="${GAFFER_MAX_TURNS:-}" \
    DISPATCH_ONBOARD_REPO="$abs" node "$RUNNER_DIR/bin/onboard-run.mjs" --repo "$abs" ${alias:+--name "$alias"} --summary 2>&1 >/dev/null \
    | sed 's/^/  /'
  # --summary: a few lines here (registered name, stack/test, model analysis yes/no and
  # why not, the intake decision, the next step); the full log (crew's scan JSON, every
  # analysis line) goes to $GAFFER_DATA/onboard.log. GAFFER_VERBOSE=1 shows it all.
  # stdout (the single-line JSON result, for the dashboard) is discarded here.
  # Surface a real onboard failure loudly — ${PIPESTATUS[0]} is the node exit, not sed's.
  orc=${PIPESTATUS[0]}
  if [ "$orc" -ne 0 ]; then err "onboard failed (exit $orc) — see the output above and $GAFFER_DATA/onboard.log"; exit "$orc"; fi
  ;;

dashboard)
  want_lan=0; want_restart=0; want_fg=0; want_stop=0
  for a in "$@"; do case "$a" in --lan) want_lan=1;; --restart) want_restart=1;; --foreground) want_fg=1;; --stop) want_stop=1;; *) bad_arg dashboard "unknown option '$a'";; esac; done
  [ "$want_stop" = 1 ] && [ "$#" -gt 1 ] && bad_arg dashboard "--stop takes no other option"
  # Owner-only state dir (it holds the token file): installs from before setup.sh made
  # it 0700 are tightened here too.
  mkdir -p "$GAFFER_DATA" && chmod 700 "$GAFFER_DATA" 2>/dev/null || true
  DASH_LOG="$GAFFER_DATA/dashboard.log"
  TOKFILE="$GAFFER_DATA/dashboard-token"
  # A server from before the fix echoed a freshly generated token into dashboard.log,
  # created 0644 (a `>` redirect keeps an existing file's mode). True when that log
  # still holds one — a credential any local user could read.
  dash_log_leaked() { grep -Eq 'Authorization: Bearer [A-Za-z0-9_-]{20,}' "$DASH_LOG" 2>/dev/null; }
  # dash_log_reset — called only when no server of ours is running: a leaked log is
  # deleted AND the token rotated (the next start generates a new one; `gaffer dashboard`
  # prints its login URL). A clean log is KEPT until the new server is confirmed up
  # (the new server writes to dashboard.log.new, renamed over it on success), so a
  # start that fails never wipes the log of the server that was working.
  dash_log_reset() {
    if dash_log_leaked; then
      rm -f "$TOKFILE" "$DASH_LOG"
      warn "an old dashboard.log held the dashboard token — rotated it (open the new login URL below)"
    fi
  }
  # dash_stop_running <verb> — stop this factory's server: the one the PID file names,
  # else a dispatch api server holding the port (a lost PID file, a --foreground run).
  # Never a process whose command line is not the dispatch api bin. Prints what it did;
  # 0 when nothing of ours is running any more, 1 when it could not stop it.
  dash_stop_running() {
    local found _p _how
    if found="$(gaffer_dashboard_find "$DASH_PORT")"; then
      _p="${found%% *}"; _how="${found#* }"
      case "$_how" in other\ *)
        err "port $DASH_PORT is held by pid $_p, the dashboard of another factory (GAFFER_DATA=${_how#other }) — not stopping it from here; stop it there, or set DISPATCH_API_PORT"
        return 1 ;;
      esac
      if gaffer_dashboard_stop_pid "$_p"; then
        rm -f "$(gaffer_dashboard_pidfile)" 2>/dev/null || true
        if [ "$_how" = port ]; then ok "$1 the dashboard on port $DASH_PORT (pid $_p, found by its port: it had no valid pid file)"
        else ok "$1 the dashboard (pid $_p)"; fi
        return 0
      fi
      err "could not stop the dashboard (pid $_p) — stop it yourself: kill $_p"
      return 1
    fi
    rm -f "$(gaffer_dashboard_pidfile)" 2>/dev/null || true
    return 0
  }
  # dash_port_busy_msg — the EADDRINUSE explanation, naming the holder when it can.
  dash_port_busy_msg() {
    local _h _f
    _h="$(gaffer_port_listener_pid "$DASH_PORT" 2>/dev/null || true)"
    _f="$(gaffer_dashboard_find "$DASH_PORT" 2>/dev/null || true)"
    case "$_f" in
      *" other "*)
        printf 'port %s is already in use by pid %s, the dashboard of another factory (GAFFER_DATA=%s); stop it there or set DISPATCH_API_PORT' "$DASH_PORT" "${_f%% *}" "${_f#* other }" ;;
      *" port")
        printf 'port %s is already in use by pid %s, a dispatch dashboard with no valid pid file (this factory'"'"'s, its pid file lost?); `gaffer dashboard --restart` replaces it, `gaffer dashboard --stop` stops it, or set DISPATCH_API_PORT' "$DASH_PORT" "${_f%% *}" ;;
      *)
        printf 'port %s is already in use%s (another dashboard?); stop it or set DISPATCH_API_PORT' "$DASH_PORT" "${_h:+ by pid $_h}" ;;
    esac
  }
  # The token the server will use: an operator-set DISPATCH_API_TOKEN wins (the server
  # reads it from the env), else the saved token file.
  dash_token() { if [ -n "$_GAFFER_OP_API_TOKEN" ]; then printf '%s' "$_GAFFER_OP_API_TOKEN"; else tr -d ' \n' < "$TOKFILE" 2>/dev/null; fi; }
  # dash_wait_ready <pid> <startup-log> — the server THIS call started is up: the process
  # is alive, it logged its OWN "listening" line (so it bound the port — a server that
  # died on EADDRINUSE never does), /healthz answers, and an authenticated request with
  # the token it uses succeeds. An old server still answering on the port satisfies
  # none of the first two. 0 = ready; 1 = it died; 2 = it never answered in time.
  dash_wait_ready() {
    local _np="$1" _nl="$2" _t _deadline=$((SECONDS + ${GAFFER_DASHBOARD_START_TIMEOUT:-30}))
    while :; do
      kill -0 "$_np" 2>/dev/null || return 1
      if grep -q 'dispatch-api listening on' "$_nl" 2>/dev/null; then
        _t="$(dash_token)"
        if [ -n "$_t" ] \
          && curl -fsS --max-time 5 "http://127.0.0.1:$DASH_PORT/healthz" >/dev/null 2>&1 \
          && curl -fsS --max-time 10 -H "Authorization: Bearer $_t" "http://127.0.0.1:$DASH_PORT/api/dashboard" >/dev/null 2>&1; then
          kill -0 "$_np" 2>/dev/null && return 0
          return 1
        fi
      fi
      [ "$SECONDS" -ge "$_deadline" ] && return 2
      sleep 0.2
    done
  }
  # dash_launch <host> [VAR=value…] — start the detached server, confirm it, adopt it.
  # Output goes to dashboard.log.new until the server is confirmed; only then is it
  # renamed over dashboard.log and its PID recorded. On failure the new process is
  # stopped, its output is kept as dashboard-failed.log, the reason is said, exit 1.
  dash_launch() {
    local _host="$1" _np _rc _why _last; shift
    local _nl="$DASH_LOG.new" _fl="$GAFFER_DATA/dashboard-failed.log"
    rm -f "$_nl"; ( umask 077; : > "$_nl" )
    nohup env $(gaffer_dashboard_env_unset_flags) GAFFER_DATA="$GAFFER_DATA" CREW_DIR="$CREW_DIR" CREW_CONFIG="$CREW_CONFIG" MEMORY_CLI_BIN="$MEMORY_CLI_BIN" MEMORY_DB="$MEMORY_DB" DISPATCH_DB="$DISPATCH_DB" DISPATCH_PRODUCT_OWNER_CMD="$PRODUCT_OWNER_CMD" DISPATCH_PRODUCT_OWNER_REPO="${DISPATCH_PRODUCT_OWNER_REPO:-}" DISPATCH_MERGE_CMD="$MERGE_CMD" DISPATCH_TICK_CMD="$TICK_CMD" DISPATCH_ONBOARD_CMD="$ONBOARD_CMD" DISPATCH_EPIC_FEATURE_CMD="$EPIC_FEATURE_CMD" GAFFER_DASHBOARD_URL="$GAFFER_DASHBOARD_URL" "$@" node "$DISPATCH_DIR/dist/api/bin.js" --port "$DASH_PORT" --host "$_host" >>"$_nl" 2>&1 </dev/null &
    _np=$!
    _rc=0; dash_wait_ready "$_np" "$_nl" || _rc=$?
    if [ "$_rc" -eq 0 ]; then
      mv -f "$_nl" "$DASH_LOG"; chmod 600 "$DASH_LOG" 2>/dev/null || true
      gaffer_dashboard_write_pid "$_np"   # OUR server, confirmed: precise restart/status
      return 0
    fi
    gaffer_dashboard_stop_pid "$_np" >/dev/null 2>&1 || true
    mv -f "$_nl" "$_fl" 2>/dev/null || true
    if grep -q 'EADDRINUSE' "$_fl" 2>/dev/null; then
      _why="$(dash_port_busy_msg)"
    elif [ "$_rc" -eq 2 ]; then
      _why="the server did not answer within ${GAFFER_DASHBOARD_START_TIMEOUT:-30}s (stopped it)"
    else
      _last="$(grep -v '^[[:space:]]*$' "$_fl" 2>/dev/null | grep -v '^[[:space:]]*at ' | tail -1 | cut -c1-240)"
      _why="the server exited${_last:+: $_last}"
    fi
    err "dashboard failed to start — $_why"
    printf '    server output: %s\n' "$_fl" >&2
    exit 1
  }

  if [ "$want_stop" = 1 ]; then
    # Stop this factory's server and drop its PID file. Idempotent; a port held by
    # something that is not a dispatch dashboard is left alone (and said so).
    if gaffer_dashboard_find "$DASH_PORT" >/dev/null; then dash_stop_running "stopped" || exit 1; exit 0; fi
    rm -f "$(gaffer_dashboard_pidfile)" 2>/dev/null || true
    ok "dashboard not running (nothing to stop)"
    _h="$(gaffer_port_listener_pid "$DASH_PORT" 2>/dev/null || true)"
    [ -n "$_h" ] && warn "port $DASH_PORT is held by pid $_h, which is not a gaffer dashboard — left alone"
    exit 0
  fi

  if [ "$want_fg" = 1 ]; then
    # FOREGROUND (compose / systemd / any supervisor): the SAME env wiring as the
    # detached paths below, exec'd in this process so the supervisor owns the lifetime
    # and the logs. Always token-protected (a container binds every interface; the
    # compose file maps the port to loopback on the host). Bind 0.0.0.0 with --lan,
    # loopback otherwise. Prints the login URL first so `docker compose logs` shows it.
    dash_log_leaked && { rm -f "$TOKFILE" "$DASH_LOG"; warn "an old dashboard.log held the dashboard token — rotated it"; }
    [ -s "$TOKFILE" ] || { umask 077; (openssl rand -hex 16 2>/dev/null || head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n') > "$TOKFILE"; }
    TOK="$(tr -d ' \n' < "$TOKFILE")"
    fg_host="127.0.0.1"; [ "$want_lan" = 1 ] && fg_host="0.0.0.0"
    export GAFFER_DASHBOARD_URL="${GAFFER_DASHBOARD_URL:-http://127.0.0.1:$DASH_PORT}"
    say "dashboard (foreground, $fg_host:$DASH_PORT) — open with your token: $GAFFER_DASHBOARD_URL/?token=$TOK"
    exec env $(gaffer_dashboard_env_unset_flags) GAFFER_DATA="$GAFFER_DATA" CREW_DIR="$CREW_DIR" CREW_CONFIG="$CREW_CONFIG" MEMORY_CLI_BIN="$MEMORY_CLI_BIN" MEMORY_DB="$MEMORY_DB" DISPATCH_DB="$DISPATCH_DB" DISPATCH_PRODUCT_OWNER_CMD="$PRODUCT_OWNER_CMD" DISPATCH_PRODUCT_OWNER_REPO="${DISPATCH_PRODUCT_OWNER_REPO:-}" DISPATCH_MERGE_CMD="$MERGE_CMD" DISPATCH_TICK_CMD="$TICK_CMD" DISPATCH_ONBOARD_CMD="$ONBOARD_CMD" DISPATCH_EPIC_FEATURE_CMD="$EPIC_FEATURE_CMD" DISPATCH_API_TOKEN="$TOK" GAFFER_DASHBOARD_URL="$GAFFER_DASHBOARD_URL" node "$DISPATCH_DIR/dist/api/bin.js" --port "$DASH_PORT" --host "$fg_host"
  fi
  # Precise running-detection: a recorded+validated PID (alive AND its command is
  # the dispatch api bin), not a broad `pgrep -f` that can match another checkout.
  pid="$(gaffer_dashboard_pid 2>/dev/null || true)"
  if [ -n "$pid" ] && [ "$want_restart" = 0 ] && [ "$want_lan" = 0 ]; then
    ok "dashboard already up → http://127.0.0.1:$DASH_PORT (pid $pid)"
    # Re-running is how an operator gets back in, so hand over the login URL again (a
    # --lan server persisted its reachable base in dashboard-url). It used to print
    # the bare URL, whose login gate pointed at "the terminal that started" the
    # detached server — which had printed nothing.
    _base="$(cat "$GAFFER_DATA/dashboard-url" 2>/dev/null)"; _base="${_base:-http://127.0.0.1:$DASH_PORT}"
    chmod 600 "$DASH_LOG" 2>/dev/null || true
    if [ -n "$_GAFFER_OP_API_TOKEN" ]; then
      printf "    open %s and log in with the DISPATCH_API_TOKEN you set\n" "$_base"
    elif [ ! -s "$TOKFILE" ]; then
      # The server holds its token in memory; the file that held it is gone, so no
      # login URL can be printed. Only a restart (which writes a new one) gets back in.
      err "the dashboard is running but its token file ($TOKFILE) is gone — no login URL to print; \`gaffer dashboard --restart\` rotates the token and prints a new one"
      exit 1
    else
      printf "    open with your token:\n    ${c_cya}%s/?token=%s${c_off}\n" "$_base" "$(dash_token)"
    fi
    dash_log_leaked && warn "dashboard.log holds the running server's token — \`gaffer dashboard --restart\` rotates it"
    exit 0
  fi
  # --restart or --lan both need a fresh bind (lan changes host + auth). Stop the old
  # server for real — found by its PID file or, failing that, by the port — so the new
  # one can bind and the token can rotate.
  if [ "$want_restart" = 1 ] || [ "$want_lan" = 1 ]; then
    dash_stop_running "stopped" || exit 1
  fi
  # --restart rotates the login token: the new server generates a fresh one (an
  # operator-set DISPATCH_API_TOKEN is the operator's to change).
  if [ "$want_restart" = 1 ]; then
    if [ -n "$_GAFFER_OP_API_TOKEN" ]; then warn "the token comes from DISPATCH_API_TOKEN in your environment — not rotated"
    elif [ -e "$TOKFILE" ]; then rm -f "$TOKFILE"; say "rotating the dashboard login token"; fi
  fi
  # The port must be free before a new server is started: a held port used to start a
  # server that died on EADDRINUSE while the old one answered the readiness probe.
  _bind_host=127.0.0.1; [ "$want_lan" = 1 ] && _bind_host=0.0.0.0
  if _bind_err="$(gaffer_port_bind_check "$_bind_host" "$DASH_PORT")"; then :; else
    case "$_bind_err" in
      EADDRINUSE) err "dashboard not started — $(dash_port_busy_msg)" ;;
      *) err "dashboard not started — cannot bind $_bind_host:$DASH_PORT (${_bind_err:-unknown error}); set DISPATCH_API_PORT to another port" ;;
    esac
    exit 1
  fi
  dash_log_reset

  if [ "$want_lan" = 1 ]; then
    # LAN bind, made safe by a bearer token (generated once, stored 0600).
    [ -s "$TOKFILE" ] || { umask 077; (openssl rand -hex 16 2>/dev/null || head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n') > "$TOKFILE"; }
    TOK="$(tr -d ' \n' < "$TOKFILE")"
    # LAN IP for the "open this URL" hint. macOS: ipconfig getifaddr; Linux: hostname -I
    # (first addr) or `ip route` src. Falls back to the bind address if none resolves.
    LAN="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null \
      || { hostname -I 2>/dev/null | awk '{print $1}'; } \
      || { ip -4 route get 1 2>/dev/null | awk '{print $7; exit}'; } )"
    [ -n "$LAN" ] || LAN="0.0.0.0"
    # AFK-LOOP P1: the reachable base for push-notification deep-links (the ping
    # says "decision pending" — this is where one-tap lands the operator). Without
    # it emitDecisionGate/ticketUrl produce no link. Export so the server env picks
    # it up and persist for any child that reads it.
    export GAFFER_DASHBOARD_URL="http://$LAN:$DASH_PORT"
    # BUG #6: the factory LOOP runs as a separate process and only sees the loopback
    # default from factory.config.sh — so its loop-end AFK ping would deep-link to
    # 127.0.0.1, unreachable from a phone. Persist the reachable LAN base where the
    # loop (and status.sh) read it back, so every notify deep-links to the SAME URL
    # the dashboard serves under --lan. (factory.config.sh reads this file.)
    ( umask 077; printf '%s\n' "$GAFFER_DASHBOARD_URL" > "$GAFFER_DATA/dashboard-url" ) 2>/dev/null || true
    _GAFFER_OP_API_TOKEN="$TOK" dash_launch 0.0.0.0 DISPATCH_API_TOKEN="$TOK"
    ok "dashboard up on your LAN (token-protected)"
    printf "    open:   ${c_cya}http://%s:%s${c_off}\n    token:  ${c_cya}%s${c_off}  (paste at the login prompt)\n" "$LAN" "$DASH_PORT" "$TOK"
    # AFK-LOOP P3: one-scan phone access. The QR encodes the URL WITH the token
    # (the dashboard adopts ?token=… and scrubs it from history), so scanning
    # logs you straight in — no copy-paste of the token. Optional dependency:
    # if qrencode is absent we degrade to the plain URL+token printed above.
    if command -v qrencode >/dev/null 2>&1; then
      printf "    scan to open on your phone (token embedded):\n"
      qrencode -t ANSIUTF8 "http://$LAN:$DASH_PORT/?token=$TOK" 2>/dev/null \
        || printf "    (qr render failed — use the URL + token above)\n"
    fi
    exit 0
  fi

  # AFK-LOOP P1: local loopback base so notification deep-links resolve even for
  # the non-LAN (desktop) dashboard. --lan overrides this with the LAN address.
  export GAFFER_DASHBOARD_URL="http://127.0.0.1:$DASH_PORT"
  # BUG #6 (degrade path): a plain (non-lan) dashboard is loopback-only, so drop any
  # stale persisted LAN url — the loop then falls back to the loopback default rather
  # than deep-linking to a LAN address that is no longer being served.
  rm -f "$GAFFER_DATA/dashboard-url" 2>/dev/null || true
  # The server writes its token file (ensureApiToken) BEFORE it listens, so once
  # dash_launch has confirmed it the file holds the token the server accepts.
  dash_launch 127.0.0.1
  ok "dashboard up → http://127.0.0.1:$DASH_PORT (pid $(gaffer_dashboard_pid 2>/dev/null))"
  # EVERY data request (reads included — only the SPA shell + /healthz are tokenless) needs
  # the auto-provisioned token — otherwise the first request 401s with no obvious cause.
  # Hand it to the operator as a ?token= URL the SPA adopts (and scrubs from history).
  # The delivery agent never gets it: the runner scrubs DISPATCH_API_TOKEN from its env,
  # so an agent still cannot self-approve its own work over the REST API.
  if [ -n "$_GAFFER_OP_API_TOKEN" ]; then
    printf "    log in with the DISPATCH_API_TOKEN you set\n"
  else
    printf "    to make changes (onboard · plan · approve), open with your token:\n    ${c_cya}http://127.0.0.1:%s/?token=%s${c_off}\n" "$DASH_PORT" "$(dash_token)"
  fi
  ;;

status)
  # Single-pane roll-up: all three doctors + work counts + recent ticks, and a
  # notification when a human is needed. Lives in status.sh to keep it testable.
  [ $# -eq 0 ] || bad_arg status "status takes no arguments (got '$1')"
  bash "$HERE/status.sh"
  ;;

setup)
  # nothing → running: build everything, init state (with the right config), open the UI.
  [ $# -eq 0 ] || bad_arg setup "setup takes no arguments (got '$1')"
  # setup.sh says why it stopped, and names $GAFFER_DATA/setup.log itself when it wrote
  # one: an early refusal (pnpm or node missing, Node below the floor) happens before
  # the data dir exists, so pointing at that log sent people to a file that was not there.
  bash "$HERE/setup.sh" || { err "setup failed — see the reason above"; exit 1; }
  "$HERE/gaffer" dashboard
  printf "\n${c_grn}Ready.${c_off} Onboard a repo:  ${c_cya}gaffer onboard /path/to/your/repo${c_off}\n"
  ;;

demo)
  [ $# -eq 0 ] || bad_arg demo "demo takes no arguments (got '$1')"
  DRY_RUN="${DRY_RUN:-1}" bash "$HERE/demo.sh" ;;

eval)
  # `gaffer eval replay` — the offline half of the harness: recorded deliveries
  # through the real gates, verdicts checked against each fixture (runner/eval/).
  if [ "${1:-}" = "replay" ]; then shift; exec bash "$HERE/eval/replay.sh" "$@"; fi
  case "$#:${1:-}" in 0:|1:--json) ;; *) bad_arg eval "unknown eval argument '$1'" ;; esac
  # Delivery-quality metrics from the eval ledger (docs/eval-harness.md):
  # pass rate, per-dimension means, the memory score gap (judge score on
  # submitted work, primed vs not; not an uplift — see docs/eval-harness.md),
  # and cost-per-passing-delivery.
  _ledger="${GAFFER_EVAL_LEDGER:-$GAFFER_DATA/eval-ledger.jsonl}"
  _cli="$CREW_DIR/dist/eval/evalLedgerCli.js"
  if [ ! -f "$_cli" ]; then echo "eval: crew not built — run: pnpm -C packages/crew build"; exit 1; fi
  if [ ! -s "$_ledger" ]; then
    echo "eval: no judged deliveries yet ($_ledger is empty)."
    echo "Enable post-submit judging with GAFFER_EVAL_JUDGE=1 — see docs/eval-harness.md."
    exit 0
  fi
  if [ "${1:-}" = "--json" ]; then
    node "$_cli" --mode summarize --file "$_ledger"
  else
    node "$_cli" --mode summarize --file "$_ledger" | node "$HERE/lib/json-tool.mjs" eval-summary
  fi
  ;;

wg)
  # The dispatch CLI, pinned to THIS factory's database — the "your first ticket" path
  # without a dashboard: create → ac add → repo-access set → ready → (after delivery)
  # review approve. Same binary the runner uses; nothing hidden.
  exec node "$DISPATCH_DIR/dist/cli/index.js" --db "$DISPATCH_DB" "$@"
  ;;

approve)
  # The human review gate from the CLI: `gaffer approve <ticket> [--reviewer <you>]`.
  # Records a HUMAN approval (in_review → ready_for_merge). The agent still cannot do this.
  _t="${1:-}"; [ -n "$_t" ] || { usage approve; exit 2; }; shift || true
  case "$_t" in -*) bad_arg approve "the ticket comes first (got option '$_t')" ;; esac
  _rev="${USER:-human}"; _rev_given=0
  _commits=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --reviewer) shift; [ -n "${1:-}" ] || bad_arg approve "--reviewer needs a name"; _rev="$1"; _rev_given=1 ;;
      --reviewer=*) _rev="${1#--reviewer=}"; _rev_given=1 ;;
      --commit) shift; [ -n "${1:-}" ] || bad_arg approve "--commit needs <repo>=<sha>"; _commits+=(--commit "$1") ;;
      --commit=*) _commits+=(--commit "${1#--commit=}") ;;
      *) bad_arg approve "unknown option '$1'" ;;
    esac
    shift || true
  done
  # STALE REVISION: an approval names the commit(s) you reviewed, and is refused when a
  # branch moved past them. Without --commit, show what would be approved (the heads +
  # a diffstat) and ask; with no terminal to ask on, print the heads and stop.
  if [ "${#_commits[@]}" -eq 0 ]; then
    _heads="$(node "$DISPATCH_DIR/dist/cli/index.js" --db "$DISPATCH_DB" ticket diff "$_t" --heads 2>/dev/null || true)"
    if [ -n "$_heads" ]; then
      printf 'Approving ticket %s covers exactly these commits:\n' "$_t"
      printf '%s\n' "$_heads" | sed 's/^/  /'
      node "$DISPATCH_DIR/dist/cli/index.js" --db "$DISPATCH_DB" ticket diff "$_t" 2>/dev/null \
        | node "$HERE/lib/json-tool.mjs" expr '(d.repos||[]).map(r => "  " + r.repo + ": " + (r.files||0) + " file(s), +" + (r.additions||0) + " -" + (r.deletions||0)).join("\n")' 2>/dev/null || true
      if [ -t 0 ]; then
        printf 'Approve these commits? [y/N] '
        read -r _yn || _yn=""
        case "$_yn" in y|Y|yes|YES) ;; *) echo "Not approved."; exit 1 ;; esac
        while IFS= read -r _h; do [ -n "$_h" ] && _commits+=(--commit "$_h"); done <<EOF_HEADS
$_heads
EOF_HEADS
      else
        # The command to re-run is the one typed, plus the commits: a --reviewer given
        # is kept (it used to be dropped, so the re-run recorded $USER instead).
        printf 'No terminal to confirm on: re-run with the commits you reviewed, e.g.\n  gaffer approve %s' "$_t"
        [ "$_rev_given" = 1 ] && printf ' --reviewer %q' "$_rev"
        while IFS= read -r _h; do [ -n "$_h" ] && printf ' --commit %s' "$_h"; done <<EOF_HEADS
$_heads
EOF_HEADS
        printf '\n'
        exit 2
      fi
    fi
  fi
  # One line for the person (the raw JSON stays one command away: `gaffer wg review
  # approve …`), and the next command. A refusal passes through as the CLI said it.
  _aout="$(node "$DISPATCH_DIR/dist/cli/index.js" --db "$DISPATCH_DB" review approve "$_t" --reviewer "$_rev" ${_commits[@]+"${_commits[@]}"})"; _arc=$?
  if [ "$_arc" -ne 0 ]; then [ -n "$_aout" ] && printf '%s\n' "$_aout"; exit "$_arc"; fi
  _ast="$(printf '%s' "$_aout" | node "$HERE/lib/json-tool.mjs" expr 'd.status || ""' 2>/dev/null)"
  _covered=""
  for _c in ${_commits[@]+"${_commits[@]}"}; do
    [ "$_c" = --commit ] && continue
    _covered="${_covered:+$_covered, }$(printf '%s' "$_c" | sed -E 's/([0-9a-f]{12})[0-9a-f]+/\1/')"
  done
  ok "approved ticket $_t as $_rev${_covered:+ (covers $_covered)} → ${_ast:-approved}"
  if [ "$_ast" = ready_for_merge ]; then
    printf "  next: ${c_cya}gaffer merge %s${c_off}   (lands it, as the dashboard's Merge button does)\n" "$_t"
  fi
  ;;

merge)
  # Land an approved ticket — exactly what the dashboard's Merge button runs
  # (merge-ticket.mjs: conflict-safe merge; a conflict spawns the resolver agent and
  # sends the ticket back for re-approval, never a force-merge). merge-ticket.mjs
  # refuses (exit 4, nothing touched) a ticket that is not ready_for_merge — the same
  # rule as the dashboard's merge route — so `merge` typed for `approve` lands nothing.
  _t="${1:-}"; [ -n "$_t" ] || { usage merge; exit 2; }
  case "$_t" in -*) bad_arg merge "the ticket comes first (got option '$_t')" ;; esac
  [ $# -le 1 ] || bad_arg merge "merge takes one ticket (got '$*')"
  exec env GAFFER_DATA="$GAFFER_DATA" DISPATCH_DB="$DISPATCH_DB" MEMORY_DB="$MEMORY_DB" node "$HERE/bin/merge-ticket.mjs" --ticket "$_t"
  ;;

run)
  # Live run. Without --daemon: ONE supervisor pass (drains the ready queue, honours
  # the per-day cap, then exits). With --daemon: the portable AFK loop — re-run the pass
  # every --interval seconds (default 30) until SIGINT/SIGTERM, which finish the CURRENT
  # pass then exit cleanly. This is the "walk away and it keeps working" path on Linux,
  # not just macOS. MAX_TICKS_PER_DAY still caps the day. (Read preflight.sh first.)
  # Every argument is parsed (and a bad one refused, exit 2) BEFORE anything runs: an
  # unknown flag used to be dropped silently, so `gaffer run --dry-run` (or a typo like
  # --deamon) started a LIVE, paid pass. --help is handled above, wherever it sits.
  _daemon=0; _interval="${GAFFER_DAEMON_INTERVAL:-30}"; _flag_dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --daemon) _daemon=1 ;;
      -n|--dry-run) _flag_dry=1 ;;
      --interval) shift; _interval="${1:-}" ;;
      --interval=*) _interval="${1#--interval=}" ;;
      *) bad_arg run "unknown option '$1'" ;;
    esac
    shift || true
  done
  case "$_interval" in ''|*[!0-9]*) bad_arg run "--interval needs a whole number of seconds (got '$_interval')" ;; esac
  _live_dry="${_GAFFER_OP_DRY_RUN:-0}"
  [ "$_flag_dry" = 1 ] && _live_dry=1
  [ "$_live_dry" = 1 ] && warn "DRY_RUN=1 is set in your environment — this pass previews only; unset it to deliver for real"
  # A live run needs a dollar cap (lib/budget.sh gaffer_spend_cap_ok) — said here, before
  # the daemon starts, so `--daemon` never sits backing off a refusal. loop.sh checks
  # again for a direct or scheduled run.
  if [ "$_live_dry" != 1 ] && ! DRY_RUN=0 gaffer_spend_cap_ok; then
    err "gaffer run: refusing a live run — $(gaffer_spend_cap_hint) (or preview with --dry-run)"
    exit 3
  fi
  # GAFFER_LOOP_SH: the supervisor pass to run (test seam; the real loop by default).
  _loop_sh="${GAFFER_LOOP_SH:-$HERE/loop.sh}"
  if [ "$_daemon" = 0 ]; then exec env DRY_RUN="$_live_dry" bash "$_loop_sh"; fi
  say "daemon: re-running the loop every ${_interval}s — SIGINT/SIGTERM stops cleanly (finishes the current pass); MAX_TICKS_PER_DAY caps the day"
  # shellcheck source=lib/daemon.sh
  source "$HERE/lib/daemon.sh"
  GAFFER_LOOP_SH="$_loop_sh" GAFFER_DAEMON_CONFIG="$HERE/factory.config.sh" DRY_RUN="$_live_dry" gaffer_run_daemon "$_interval"
  ;;

skills)
  # The factory selects a SUBSET of this library for each agent by ROLE (delivery,
  # review, clarify, test, plan, spec, product, merge, bootstrap — `select-skills.mjs
  # --role`) plus the ticket's stack / area / text, and mounts only that subset into
  # the agent's `.claude/skills` (lib/skills-mount.sh). This command exposes the whole
  # library to YOUR own Claude Code so you can use the skills interactively.
  sub="${1:-list}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    list)
      say "bundled skills ($(ls -d "$SKILLS_DIR"/*/ 2>/dev/null | wc -l | tr -d ' ')) — $SKILLS_DIR"
      for d in "$SKILLS_DIR"/*/; do [ -d "$d" ] && printf "  • %s\n" "$(basename "$d")"; done
      printf "  ${c_dim}each agent is mounted a role-based selection of these (select-skills --role <role>, plus the ticket's stack/area/text) — not the whole library. \`gaffer skills install\` adds them all to your own Claude Code.${c_off}\n"
      ;;
    install)
      scope="project"; force=0
      for a in "$@"; do case "$a" in --user) scope="user";; --project) scope="project";; --force) force=1;; *) bad_arg skills "unknown option '$a'";; esac; done
      [ "$scope" = user ] && dest="$HOME/.claude/skills" || dest="$PWD/.claude/skills"
      mkdir -p "$dest"
      n=0; skipped=0
      for d in "$SKILLS_DIR"/*/; do
        [ -d "$d" ] || continue; name="$(basename "$d")"; link="$dest/$name"
        if [ -e "$link" ] || [ -L "$link" ]; then
          if [ "$force" = 1 ]; then rm -rf "$link"; else skipped=$((skipped+1)); continue; fi
        fi
        ln -sfn "$SKILLS_DIR/$name" "$link" && n=$((n+1))
      done
      ok "installed $n skill(s) → $dest"
      [ "$skipped" -gt 0 ] && warn "$skipped already present — re-run with --force to overwrite"
      printf "  ${c_dim}symlinks track $SKILLS_DIR (repo updates flow through). Remove: rm \"$dest\"/<name>${c_off}\n"
      ;;
    add)
      # Install an EXTERNAL skill (local path or git url) into the factory's own
      # library ($SKILLS_DIR) after validating its SKILL.md — so select-skills can
      # pick it per-ticket like any bundled skill. Rejects invalid skills with a
      # reason and installs nothing.
      if [ $# -eq 0 ]; then
        usage skills; exit 2
      elif SKILLS_DIR="$SKILLS_DIR" node "$HERE/bin/skill-add.mjs" "$@"; then
        printf "  ${c_dim}the factory can now select this skill for an agent whose role, stack, area or ticket text matches its frontmatter. \`gaffer skills list\` to confirm.${c_off}\n"
      else
        exit 1
      fi
      ;;
    *) bad_arg skills "unknown skills subcommand '$sub'" ;;
  esac
  ;;

help|-h|--help)
  # The header comment block above, up to (not including) the "Everything uses" line.
  awk 'NR < 2 { next } /^# Everything uses/ { exit } { sub(/^# ?/, ""); print }' "$HERE/gaffer"
  ;;

-V|--version|version)
  node -p 'require(process.argv[1]).version' "$GAFFER_HOME/package.json" 2>/dev/null \
    | sed 's/^/gaffer /' || { err "could not read the version from $GAFFER_HOME/package.json"; exit 1; }
  ;;

*)
  # A typo used to print help and exit 0, so a script with a misspelt command
  # "succeeded" having done nothing.
  err "unknown command '$cmd' (see gaffer help)"; exit 2
  ;;
esac
